# Salin file ini menjadi .env lalu isi sesuai mesin kamu:
#   cp .env.example .env

PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=pastebin

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

AUTO_MIGRATE=true
MAX_CONTENT_BYTES=1048576
DEFAULT_EXPIRES_IN=
